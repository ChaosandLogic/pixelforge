{
  "appId": "com.pixelforge.editor",
  "productName": "PixelForge",
  "directories": {
    "output": "release/editor"
  },
  "files": [
    "out/**/*",
    "examples/**/*",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": ["dmg", "zip"],
    "icon": "build/icon.png",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "PixelForge analyzes audio input for reactive LED visuals.",
      "NSLocalNetworkUsageDescription": "PixelForge sends LED pixel data to fixtures on your local network via sACN, Art-Net, or DDP."
    }
  },
  "win": {
    "target": ["nsis"],
    "icon": "build/icon.png"
  },
  "linux": {
    "icon": "build/icon.png"
  },
  "publish": {
    "provider": "github",
    "owner": "pixelforge",
    "repo": "pixelforge"
  }
}
